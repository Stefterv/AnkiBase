# AnkiBase settings. install.sh writes backend/.env for you; everything here is optional.

# The port AnkiBase listens on.
APP_PORT=8000

# Origins allowed to call the API from another address (only for a separately served
# frontend during development; the app itself doesn't need it).
CORS_ORIGINS=http://localhost:5173

# How the in-app updater finds new versions: "release" (tagged releases, the default)
# or "main" (every commit on the main branch).
UPDATE_CHANNEL=release

# Server-wide AI keys, used by every profile that hasn't saved its own in Settings → AI.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# A local or other OpenAI-compatible server, e.g. Ollama (its key only if it needs one).
# CUSTOM_AI_BASE_URL=http://localhost:11434/v1
# CUSTOM_AI_API_KEY=

# Single sign-on with an OpenID Connect provider (Authentik, Keycloak, Authelia, Google…).
# Easier: set it up in Settings → Users as an admin; these are used until you save it there.
# Register AnkiBase as a client with the callback URL https://<your server>/api/auth/oidc/callback.
# OIDC_ISSUER=https://auth.example.com/application/o/ankibase/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# Only when the server can't work out its own address (behind an unusual proxy):
# OIDC_REDIRECT_URI=https://anki.example.com/api/auth/oidc/callback
# Make a user for provider accounts that aren't connected to one (they get no profiles
# until an admin gives them some). Otherwise users connect in Settings → Account.
# OIDC_AUTO_CREATE=false

# Secrets are generated on first start into backend/data/.secrets. Set these only to
# provide your own.
# APP_SECRET_KEY=
# ANKIWEB_ENCRYPTION_KEY=
